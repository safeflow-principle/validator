# Optional hosted Cloud Workspace configuration. Local Workspace needs no env file.
# These values are browser-visible by design. Never put a service-role or secret key
# in a VITE_ variable. See docs/configuration.md.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_ENABLE_LOCAL_PASSWORD_AUTH=false

