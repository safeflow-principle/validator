# Generated values from a disposable local Supabase instance.
# Run `npm run supabase:start` followed by `npm run local:env` instead of
# filling these placeholders manually.
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_PUBLISHABLE_KEY=LOCAL_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_ENABLE_LOCAL_PASSWORD_AUTH=true
