{
  "name": "safeflow-human-validator",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/safeflow-principle/validator.git"
  },
  "homepage": "https://github.com/safeflow-principle/validator#readme",
  "bugs": {
    "url": "https://github.com/safeflow-principle/validator/issues"
  },
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "npm test && npm run build",
    "generate:schemas": "node scripts/generate-schema-validators.mjs",
    "import:airbench": "tsx scripts/import-airbench.ts",
    "local:env": "node scripts/configure-local-env.mjs",
    "local:seed-users": "node scripts/seed-local-demo.mjs",
    "local:verify-rls": "node scripts/verify-local-rls.mjs",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset --local",
    "supabase:stop": "supabase stop",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "@vitejs/plugin-react": "4.3.4",
    "ajv": "8.20.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "vite": "6.4.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@types/node": "22.13.4",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "fake-indexeddb": "6.0.0",
    "jsdom": "26.0.0",
    "supabase": "2.122.1",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vitest": "5.1.0"
  }
}
