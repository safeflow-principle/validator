{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safeflow.local/schemas/benchmark-pack.schema.json",
  "title": "SafeFlow Benchmark Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "description", "provenance", "categories", "annotation"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "$ref": "#/$defs/provenancedText" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benchmark", "benchmarkVersion", "notes"],
      "properties": {
        "benchmark": { "type": "string", "minLength": 1 },
        "benchmarkVersion": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "format": "uri" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "rubric"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "$ref": "#/$defs/provenancedText" },
          "rubric": { "$ref": "#/$defs/provenancedText" }
        }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instructions", "fields"],
      "properties": {
        "instructions": { "type": "array", "items": { "$ref": "#/$defs/provenancedText" } },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/annotationField" }
        }
      }
    }
  },
  "$defs": {
    "provenancedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["official-benchmark-material", "safeflow-paraphrase", "safeflow-interpretation", "safeflow-authored-example", "unavailable"]
        },
        "text": { "type": "string" },
        "citation": { "type": "string" },
        "note": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "unavailable" } } },
          "then": { "required": ["note"] },
          "else": { "required": ["text"] }
        }
      ]
    },
    "annotationValue": { "type": ["string", "number", "boolean", "null"] },
    "annotationOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "$ref": "#/$defs/annotationValue" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "annotationField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type", "required"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "helpText": { "$ref": "#/$defs/provenancedText" },
        "type": { "enum": ["single-choice", "boolean", "number", "text"] },
        "required": { "type": "boolean" },
        "options": { "type": "array", "items": { "$ref": "#/$defs/annotationOption" } },
        "min": { "type": "number" },
        "max": { "type": "number" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "single-choice" } } },
          "then": { "required": ["options"], "properties": { "options": { "minItems": 1 } } }
        }
      ]
    }
  }
}
