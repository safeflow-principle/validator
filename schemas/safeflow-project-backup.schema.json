{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safeflow.local/schemas/safeflow-project-backup.schema.json",
  "title": "SafeFlow Local Project Backup",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "exportedAt", "provenance", "workflow", "isolatedArtifacts"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "safeflow-project-backup" },
    "exportedAt": { "$ref": "#/$defs/nonEmpty" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application", "storageMode", "source"],
      "properties": {
        "application": { "const": "SafeFlow Human Validator" },
        "storageMode": { "const": "persistent-local" },
        "source": { "const": "local-browser-project-export" }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "source", "benchmark", "progress", "items", "annotations"],
      "properties": {
        "project": { "$ref": "#/$defs/project" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fileName", "importRuns"],
          "properties": {
            "fileName": { "$ref": "#/$defs/nonEmpty" },
            "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
            "importRuns": { "type": "array", "items": { "$ref": "#/$defs/importRun" } }
          }
        },
        "benchmark": {
          "type": "object",
          "additionalProperties": false,
          "required": ["packId", "packVersion", "rubricVersion", "pack"],
          "properties": {
            "packId": { "$ref": "#/$defs/nonEmpty" },
            "packVersion": { "$ref": "#/$defs/nonEmpty" },
            "rubricVersion": { "$ref": "#/$defs/nonEmpty" },
            "pack": { "$ref": "https://safeflow.local/schemas/benchmark-pack.schema.json" }
          }
        },
        "progress": { "$ref": "#/$defs/progress" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
        "annotations": { "type": "array", "items": { "$ref": "#/$defs/annotation" } }
      }
    },
    "isolatedArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["judgeArtifacts", "referenceArtifacts"],
      "properties": {
        "judgeArtifacts": { "type": "array", "items": { "$ref": "#/$defs/judgeArtifact" } },
        "referenceArtifacts": { "type": "array", "items": { "$ref": "#/$defs/referenceArtifact" } }
      }
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "annotationValue": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }, { "type": "null" }] },
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "benchmarkPackId", "benchmarkPackVersion", "status", "createdAt", "updatedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" }, "name": { "$ref": "#/$defs/nonEmpty" },
        "benchmarkPackId": { "$ref": "#/$defs/nonEmpty" }, "benchmarkPackVersion": { "$ref": "#/$defs/nonEmpty" },
        "status": { "enum": ["READY", "VALIDATING", "REVIEW", "HUMAN_COMPLETE"] },
        "createdAt": { "$ref": "#/$defs/nonEmpty" }, "updatedAt": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "projectId", "prompt", "response", "metadata", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" }, "projectId": { "$ref": "#/$defs/nonEmpty" },
        "externalId": { "type": "string" }, "prompt": { "type": "string" }, "response": { "type": "string" },
        "categoryId": { "type": "string" }, "metadata": { "type": "object" }, "createdAt": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["start", "end", "text"],
      "properties": { "start": { "type": "integer", "minimum": 0 }, "end": { "type": "integer", "minimum": 1 }, "text": { "type": "string", "minLength": 1 } }
    },
    "annotation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "itemId", "projectId", "validatorId", "benchmarkPackId", "status", "answers", "evidenceSpans", "revision", "createdAt", "updatedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" }, "itemId": { "$ref": "#/$defs/nonEmpty" }, "projectId": { "$ref": "#/$defs/nonEmpty" },
        "validatorId": { "$ref": "#/$defs/nonEmpty" }, "benchmarkPackId": { "$ref": "#/$defs/nonEmpty" },
        "status": { "enum": ["draft", "submitted"] },
        "answers": { "type": "object", "additionalProperties": { "$ref": "#/$defs/annotationValue" } },
        "notes": { "type": "string" }, "evidenceSpans": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "revision": { "type": "integer", "minimum": 0 }, "createdAt": { "$ref": "#/$defs/nonEmpty" },
        "updatedAt": { "$ref": "#/$defs/nonEmpty" }, "submittedAt": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "importRun": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "projectId", "sourceName", "status", "itemCount", "errors", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" }, "projectId": { "$ref": "#/$defs/nonEmpty" }, "sourceName": { "$ref": "#/$defs/nonEmpty" },
        "status": { "enum": ["pending", "complete", "failed"] }, "itemCount": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array", "items": { "type": "string" } }, "warnings": { "type": "array", "items": { "type": "string" } },
        "format": { "type": "string" }, "mapping": { "type": "object", "additionalProperties": { "type": "string" } },
        "sourceSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }, "createdAt": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "progress": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "unseen", "drafts", "submitted", "flagged", "lowConfidence", "skipped", "percentComplete"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 }, "unseen": { "type": "integer", "minimum": 0 },
        "drafts": { "type": "integer", "minimum": 0 }, "submitted": { "type": "integer", "minimum": 0 },
        "flagged": { "type": "integer", "minimum": 0 }, "lowConfidence": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }, "percentComplete": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "judgeArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "itemId", "judgeId", "score", "metadata", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" }, "itemId": { "$ref": "#/$defs/nonEmpty" }, "judgeId": { "$ref": "#/$defs/nonEmpty" },
        "score": { "$ref": "#/$defs/annotationValue" }, "reasoning": { "type": "string" }, "metadata": { "type": "object" }, "createdAt": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "referenceArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "itemId", "label", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" }, "itemId": { "$ref": "#/$defs/nonEmpty" },
        "label": { "anyOf": [{ "$ref": "#/$defs/annotationValue" }, { "type": "object", "additionalProperties": { "$ref": "#/$defs/annotationValue" } }] },
        "provenance": { "type": "string" }, "createdAt": { "$ref": "#/$defs/nonEmpty" }
      }
    }
  }
}
